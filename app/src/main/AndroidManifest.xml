<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fully offline: no INTERNET or storage permissions -->

    <application
        android:name=".VantaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_vanta"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_vanta"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vanta"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.Vanta"
            android:windowSoftInputMode="adjustResize" />

        <!-- 1. Vanta — pearl & ember (Default Enabled) -->
        <activity-alias
            android:name=".IconVantaAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vanta"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_vanta"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 2. Frames — slate & ice -->
        <activity-alias
            android:name=".IconFramesAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_frames"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_frames"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 3. Pulse — ink & violet -->
        <activity-alias
            android:name=".IconPulseAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pulse"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_pulse"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 4. Orbit — charcoal & champagne -->
        <activity-alias
            android:name=".IconOrbitAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orbit"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_orbit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 5. Ribbon — forest & sage -->
        <activity-alias
            android:name=".IconRibbonAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ribbon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ribbon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 6. Mono — graphite & silver -->
        <activity-alias
            android:name=".IconMonoAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mono"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
